{
  "name": "finnwiel/shazzoo-media",
  "description": "A media library for Laravel",
  "type": "library",
  "license": "MIT",
    "authors": [
    {
      "name": "Finn van de Wiel",
      "email": "finnvandewiel01@gmail.com"
    }
  ],
  "autoload": {
    "psr-4": {
      "FinnWiel\\ShazzooMedia\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FinnWiel\\ShazzooMedia\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "FinnWiel\\ShazzooMedia\\ShazzooMediaServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "require": {
    "php": "^8.2",
    "illuminate/support": "^11.0 || ^12.0 || ^13.0",
    "intervention/image": "^3.9",
    "livewire/livewire": "^3.5",
    "filament/filament": "^4.0",
    "awcodes/filament-curator": "4.0.5",
    "spatie/laravel-package-tools": "^1.0"
  },
  "require-dev": {
    "orchestra/testbench": "^9.17 || ^10.11 || ^11.0",
    "phpunit/phpunit": "^10.5.35 || ^11.5.3 || ^12.5.8"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
